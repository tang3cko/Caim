FROM rust:1-trixie
RUN apt-get update \
 && apt-get install -y --no-install-recommends zsh expect shellcheck procps \
 && rm -rf /var/lib/apt/lists/*
# Debian has no actionlint package; the version and checksum are mise.lock's.
ADD --checksum=sha256:325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6 \
    https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_arm64.tar.gz /tmp/actionlint.tar.gz
RUN tar -xzf /tmp/actionlint.tar.gz -C /usr/local/bin actionlint && rm /tmp/actionlint.tar.gz
