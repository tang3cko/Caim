#!/usr/bin/env bash
# Release notes for a tag, from the Conventional Commits since the tag before it.
set -euo pipefail
TAG="${1:-${CAIM_ARG_TAG:-}}"
[[ -n "$TAG" ]] || { echo "usage: tasks/release-notes TAG" >&2; exit 64; }
git rev-parse -q --verify "refs/tags/$TAG" > /dev/null || { echo "no tag $TAG" >&2; exit 64; }

previous="$(git describe --tags --abbrev=0 --match 'v*' "$TAG^" 2> /dev/null || true)"
range="$TAG"
[[ -n "$previous" ]] && range="$previous..$TAG"

breaking=() features=() fixes=() other=()
while IFS=$'\t' read -r sha subject; do
  type="${subject%%:*}"
  line="- ${subject#*: } ($sha)"
  if [[ "$type" == *'!' ]] || git log -1 --format=%B "$sha" | grep -q '^BREAKING CHANGE:'; then
    breaking+=("$line")
  fi
  case "${type%!}" in
    feat) features+=("$line") ;;
    fix) fixes+=("$line") ;;
    perf | refactor | docs) other+=("$line") ;;
  esac
done < <(git log --no-merges --format=$'%h\t%s' "$range")

section() {
  local title="$1"
  shift
  (( $# )) || return 0
  printf '## %s\n\n' "$title"
  printf '%s\n' "$@"
  printf '\n'
}
section "Breaking changes" ${breaking[@]+"${breaking[@]}"}
section "Features" ${features[@]+"${features[@]}"}
section "Fixes" ${fixes[@]+"${fixes[@]}"}
section "Other changes" ${other[@]+"${other[@]}"}
if [[ -n "$previous" && -n "${GITHUB_REPOSITORY:-}" ]]; then
  echo "**Full changelog**: https://github.com/$GITHUB_REPOSITORY/compare/$previous...$TAG"
fi
