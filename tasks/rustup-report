#!/usr/bin/env bash
# For a CI step that failed setting up Rust on macOS: what each rustup on PATH is, whether its code
# signature holds, and what the kernel logged about killing it.
set -uo pipefail
for rustup in /opt/homebrew/opt/rustup/bin/rustup "$HOME/.cargo/bin/rustup"; do
  [[ -e "$rustup" ]] || continue
  echo "== $rustup"
  ls -l "$rustup"
  codesign -dv "$rustup" 2>&1
  codesign --verify --strict "$rustup" 2>&1 && echo "signature verifies"
  "$rustup" --version 2>&1
  echo "exit=$?"
done
echo "== kernel log, last 10 minutes"
log show --last 10m --style compact \
  --predicate 'eventMessage CONTAINS[c] "rustup" OR eventMessage CONTAINS[c] "code signature"' 2>&1 | tail -n 50
