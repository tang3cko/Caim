#!/usr/bin/env bash
set -euo pipefail
HOME_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="$HOME_DIR/target"
BINARY="$TARGET/release/caim"
STAMP="$TARGET/release/caim.sources"

fingerprint() {
  (cd "$HOME_DIR" && { LC_ALL=C find src Cargo.toml Cargo.lock -type f -print; echo mise.toml; } \
    | LC_ALL=C sort | tr '\n' '\0' | xargs -0 shasum -a 256 | shasum -a 256 | cut -d' ' -f1)
}

current() { [[ -x "$BINARY" && -f "$STAMP" && "$(cat "$STAMP")" == "$(fingerprint)" ]]; }

build() {
  local sources log=$TARGET/build.log cargo=(cargo) rust
  sources="$(fingerprint)"
  mkdir -p "$TARGET"
  rust="$(sed -n 's/^rust = .*version = "\([^"]*\)".*/\1/p' "$HOME_DIR/mise.toml")"
  # rustup itself selects the Rust pinned in mise.toml, offline. mise exec checks the install first,
  # and on the macOS runner it judged the installed toolchain missing and went to reinstall it.
  if [[ -n "$rust" ]] && command -v rustup > /dev/null; then
    cargo=(env RUSTUP_TOOLCHAIN="$rust" RUSTUP_AUTO_INSTALL=0 cargo)
  elif command -v mise > /dev/null; then
    cargo=(env MISE_OFFLINE=1 mise exec -C "$HOME_DIR" rust -- cargo)
  fi
  if ! CARGO_TARGET_DIR="$TARGET" "${cargo[@]}" build --offline --release --quiet \
      --manifest-path "$HOME_DIR/Cargo.toml" > "$log" 2>&1; then
    cat "$log" >&2
    echo "caim did not build ($HOME_DIR); log: $log" >&2
    if grep -qF -- '--offline' "$log"; then
      echo "the build is offline; cargo fetch --locked brings the crates into the local cache" >&2
    fi
    exit 125
  fi
  printf '%s\n' "$sources" > "$STAMP.$$" && mv -f "$STAMP.$$" "$STAMP"
}

case "${1:-}" in
  --check)
    current || { echo "the caim binary is missing or stale; ./caim --build brings it up to date" >&2; exit 1; }
    exit 0 ;;
  --build)
    current || build
    echo 'caim is current'
    exit 0 ;;
esac
current || build
exec "$BINARY" "$@"
